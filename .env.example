# Database configuration (PostgreSQL / SQLite / MySQL)
# SQLite example: "file:./dev.db"
# PostgreSQL example: "postgresql://postgres:password@localhost:5432/doubtbridge?schema=public"
DATABASE_URL="file:./dev.db"

# NextAuth / Auth Secret
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# Application Config
NEXT_PUBLIC_APP_NAME="DoubtBridge"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
